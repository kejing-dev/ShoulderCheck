# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log
.DS_Store

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Session scratch (logs, gate results, harness state, test output)
.scratch/
.kotlin/
tools/harness/.state/
tools/test/out/

# 3D models: raw Tripo exports (57-62 MB each) never enter the repo; only the decimated, calibrated
# GLBs under app/src/main/assets/models/ ship with the app.
*.glb
!app/src/main/assets/models/*.glb
